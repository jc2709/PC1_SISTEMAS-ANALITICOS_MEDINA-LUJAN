{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["api/**/*.ts", "frontend/api/**/*.ts", "frontend/server/**/*.ts"],
  "exclude": ["api/**/*.test.ts", "frontend/**/*.test.ts", "tests/**/*.ts"]
}
