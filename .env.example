# Variables privadas: configurar solo en Vercel o en el backend local.
# Nunca usar el prefijo VITE_ ni incluir estas variables en el frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Orígenes web autorizados, separados por comas.
AI_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# Habilitar solo si el HTML/EXE portable debe consumir esta API desde un origen local.
AI_ALLOW_LOCAL_APP=false

# Esta URL sí es pública y puede configurarse en el frontend durante el build.
VITE_AI_API_BASE_URL=
